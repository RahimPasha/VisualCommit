<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The diff view (D64). AvaloniaEdit 12.0.0 is built against Avalonia 12.0.0 and works with 12.1.3. -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- The Secret Service's D-Bus client on Linux (docs/phase-7a-design.md 1.1, 3.6): the version
         Avalonia 12.1.3 resolves, so it moves with AvaloniaVersion, as xunit does (D24). -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />

    <!-- Tests -->
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- Not the newest xunit.v3: Avalonia.Headless.XUnit 12.1.3 is built against 3.2.2 and fails to
         discover tests with 4.x (decision D24). Move both together. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />

    <!-- Tools: the icon's builder, tools/VisualCommit.IconBuilder (D428), which is never shipped.
         Svg.Skia stays on 4.9.1: 5.x needs SkiaSharp 4.x, which Avalonia 12.1.3 does not take. The
         other three are the versions Avalonia.Skia 12.1.3 resolves, so they move with
         AvaloniaVersion. Only the tool references them, and no transitive pinning is set, so no
         other project's packages change. -->
    <PackageVersion Include="Svg.Skia" Version="4.9.1" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
  </ItemGroup>
</Project>
