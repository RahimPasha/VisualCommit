<Project Sdk="Microsoft.NET.Sdk">

  <!-- The scripted walk-through of the visual test gate (docs/plan.md) for phase 5's parts A, B, F
       and P: their checks, their expected values and support (docs/phase-5-design.md 15.3, D181).
       It drives the whole app in Avalonia's headless mode and saves a screenshot after every step
       under artifacts/visual/phase-5/ (VisualRun, in VisualCommit.Testing). A project of its own,
       as phase 3's and phase 4's are (D133, D151): a test assembly has one headless UI thread, on
       which its headless tests run one at a time, and a second assembly is a second test process
       with a UI thread of its own that "dotnet test" runs beside the others. Part U, the undo
       checks, is VisualCommit.VisualTests.Phase5Undo, which compiles this project's base class,
       support and common expectations. The real-window pass compiles the Phase5Expectations files
       from here. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisualCommit.App\VisualCommit.App.csproj" />
    <ProjectReference Include="..\..\src\VisualCommit.Core\VisualCommit.Core.csproj" />
    <ProjectReference Include="..\..\src\VisualCommit.Git\VisualCommit.Git.csproj" />
    <ProjectReference Include="..\VisualCommit.Testing\VisualCommit.Testing.csproj" />
  </ItemGroup>

</Project>
