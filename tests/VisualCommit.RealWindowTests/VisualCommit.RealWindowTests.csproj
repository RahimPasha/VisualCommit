<Project Sdk="Microsoft.NET.Sdk">

  <!-- The real-window pass of the visual test gate (docs/plan.md). It starts the built app on
       the real Windows desktop and drives it with the real mouse through UI Automation (FlaUI).

       Windows-only and opt-in: this project is NOT in VisualCommit.slnx, so "dotnet build" and
       "dotnet test" at the repo root never touch it. It is run on its own, with the real-window
       command in the Commands section of CLAUDE.md. It takes over the mouse for about 25 minutes
       with phases 0 to 5 (24 min 57 s at phase 5's gate, 59 tests), more as phases add checks,
       and needs an unlocked desktop. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the app first, in the same configuration. The tests start its executable; they
         do not load its code. -->
    <ProjectReference Include="..\..\src\VisualCommit.App\VisualCommit.App.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />

    <!-- The shared test helpers: scenario repos (TempRepo, Scenarios), the git isolation and
         the session file that opens repositories when the app starts (D46). -->
    <ProjectReference Include="..\VisualCommit.Testing\VisualCommit.Testing.csproj" />
  </ItemGroup>

  <!-- Phase 3's expectations, shared with the scripted walk-through, so that the pass clicks and
       compares with the same constants and texts (docs/phase-3-design.md 7.4). Those files use
       nothing of VisualCommit.VisualTests.Phase3 but themselves. -->
  <ItemGroup>
    <Compile Include="..\VisualCommit.VisualTests.Phase3\Phase3Expectations*.cs" Link="Phase3\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Phase 4's expectations, likewise (docs/phase-4-design.md 13.3). The walk-through's own tests
       of them, Phase4ExpectationTests.<part>.cs, are left out by their name, which the pattern
       does not match. -->
  <ItemGroup>
    <Compile Include="..\VisualCommit.VisualTests.Phase4\Phase4Expectations*.cs" Link="Phase4\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Phase 5's expectations, likewise (docs/phase-5-design.md 15.3), from both of its walk-through
       projects: the common ones and parts A, B, F and P from VisualCommit.VisualTests.Phase5, part
       U from VisualCommit.VisualTests.Phase5Undo. Their own tests, Phase5ExpectationTests.<part>.cs
       and Phase5SupportTests.cs, are left out by their names, which the pattern does not match. -->
  <ItemGroup>
    <Compile Include="..\VisualCommit.VisualTests.Phase5*\Phase5Expectations*.cs" Link="Phase5\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot" Value="$(RepoRoot)" />
    <AssemblyMetadata Include="AppExecutable" Value="$(RepoRoot)src\VisualCommit.App\bin\$(Configuration)\net10.0\VisualCommit.exe" />
  </ItemGroup>

</Project>
