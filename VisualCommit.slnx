<Solution>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="CLAUDE.md" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/VisualCommit.App/VisualCommit.App.csproj" />
    <Project Path="src/VisualCommit.AskPass/VisualCommit.AskPass.csproj" />
    <Project Path="src/VisualCommit.Core/VisualCommit.Core.csproj" />
    <Project Path="src/VisualCommit.Git/VisualCommit.Git.csproj" />
    <Project Path="src/VisualCommit.Hosting/VisualCommit.Hosting.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <!-- VisualCommit.RealWindowTests is left out on purpose: it takes over the mouse and is
         Windows-only, so it must never run as part of "dotnet test" at the repo root.
         VisualCommit.LiveHostingTests is left out on purpose too: it acts on the owner's accounts
         of GitHub, Azure DevOps and GitLab with tokens from the environment and runs only by its
         own command (D250, D346). VisualCommit.GuideShots is left out too: it makes the user
         guide's pictures, needs a demo root outside the repository and runs by its own command
         and in the guide's workflow (D439). -->
    <Project Path="tests/VisualCommit.App.Tests/VisualCommit.App.Tests.csproj" />
    <Project Path="tests/VisualCommit.Git.Tests/VisualCommit.Git.Tests.csproj" />
    <!-- The stand-in for git of the first-run checks: a small program that answers only the
         question for git's version, which the tests point the app at in place of the machine's
         git. -->
    <Project Path="tests/VisualCommit.GitStandIn/VisualCommit.GitStandIn.csproj" />
    <Project Path="tests/VisualCommit.Hosting.Tests/VisualCommit.Hosting.Tests.csproj" />
    <Project Path="tests/VisualCommit.Testing/VisualCommit.Testing.csproj" />
    <Project Path="tests/VisualCommit.VisualTests/VisualCommit.VisualTests.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase3/VisualCommit.VisualTests.Phase3.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase4/VisualCommit.VisualTests.Phase4.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase5/VisualCommit.VisualTests.Phase5.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase5Undo/VisualCommit.VisualTests.Phase5Undo.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase6/VisualCommit.VisualTests.Phase6.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase6Look/VisualCommit.VisualTests.Phase6Look.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase7a/VisualCommit.VisualTests.Phase7a.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase7b/VisualCommit.VisualTests.Phase7b.csproj" />
    <Project Path="tests/VisualCommit.VisualTests.Phase8a/VisualCommit.VisualTests.Phase8a.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <!-- Makes the icon's files from the masters in assets/brand/. It is built with the solution,
         never shipped, and run by hand when a master changes (D428). -->
    <Project Path="tools/VisualCommit.IconBuilder/VisualCommit.IconBuilder.csproj" />
  </Folder>
</Solution>
