# Text files are stored with LF in the repository and checked out with the platform's line endings.
* text=auto

*.cs    text diff=csharp
*.axaml text
*.sh    text eol=lf
# The icon's tool writes its manifest with LF on every machine, so the checkout keeps LF too and a
# run of the tool with nothing changed leaves the file as it is.
assets/brand/generated/manifest.json text eol=lf

*.png binary
*.ico binary
*.icns binary
*.ttf binary
