<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VisualCommit.App.Controls"
             xmlns:local="using:VisualCommit.App.Views.Shell"
             xmlns:ops="using:VisualCommit.App.ViewModels.Operations"
             x:Class="VisualCommit.App.Views.Shell.ConflictBanner"
             x:DataType="ops:ConflictBannerViewModel"
             MinHeight="36"
             AutomationProperties.AutomationId="ConflictBanner"
             AutomationProperties.Name="{Binding Text}">

  <!-- The banner above the graph or the diff while an operation is in progress or files have
       conflicts (docs/phase-3-design.md section 5; docs/phase-4-design.md 5.2, D144): the warning
       icon, what is in progress, and Continue, Skip and Abort. The buttons stand right of the
       text while the text keeps at least 240 px, otherwise on a row of their own under it
       (BannerLayoutPanel). The banner is 36 high while its text and buttons fit on one line; a
       longer text wraps and the banner grows, so that what to do next is never cut off. The icon
       and the text share the tooltip of 10.3. -->
  <Border Background="{DynamicResource VcBannerBackgroundBrush}"
          BorderBrush="{DynamicResource VcWarningBrush}"
          BorderThickness="0,0,0,1">
    <local:BannerLayoutPanel Name="BannerLayout">
      <Grid Name="BannerInfoArea" ColumnDefinitions="Auto,*">
        <Border Name="BannerInfo" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" ToolTip.Tip="{Binding ToolTip}" />
        <c:Icon Name="BannerIcon"
                Grid.Column="0"
                Data="{StaticResource IconAlert}"
                Width="16"
                Height="16"
                Margin="12,0,8,0"
                Foreground="{DynamicResource VcWarningBrush}"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />
        <TextBlock Name="BannerText"
                   Grid.Column="1"
                   Margin="0,9,8,9"
                   VerticalAlignment="Center"
                   Text="{Binding Text}"
                   Foreground="{DynamicResource VcTextPrimaryBrush}"
                   TextWrapping="Wrap"
                   IsHitTestVisible="False"
                   AutomationProperties.AutomationId="BannerText" />
      </Grid>
      <StackPanel Name="BannerButtons" Orientation="Horizontal" Spacing="6">
        <Button Name="BannerContinueButton"
                Theme="{StaticResource VcActionButton}"
                Height="26"
                Padding="10,0"
                VerticalAlignment="Center"
                Content="{x:Static ops:ConflictBannerViewModel.ContinueText}"
                Command="{Binding ContinueCommand}"
                IsVisible="{Binding HasContinue}"
                ToolTip.Tip="{Binding ContinueToolTip}"
                ToolTip.ShowOnDisabled="True"
                AutomationProperties.AutomationId="BannerContinueButton"
                AutomationProperties.Name="{x:Static ops:ConflictBannerViewModel.ContinueText}" />
        <Button Name="BannerSkipButton"
                Theme="{StaticResource VcActionButton}"
                Height="26"
                Padding="10,0"
                VerticalAlignment="Center"
                Content="{x:Static ops:ConflictBannerViewModel.SkipText}"
                Command="{Binding SkipCommand}"
                IsVisible="{Binding HasSkip}"
                ToolTip.Tip="{Binding SkipToolTip}"
                ToolTip.ShowOnDisabled="True"
                AutomationProperties.AutomationId="BannerSkipButton"
                AutomationProperties.Name="{x:Static ops:ConflictBannerViewModel.SkipText}" />
        <Button Name="BannerAbortButton"
                Theme="{StaticResource VcActionButton}"
                Height="26"
                Padding="10,0"
                VerticalAlignment="Center"
                Content="{Binding AbortText}"
                Command="{Binding AbortCommand}"
                IsVisible="{Binding HasAbort}"
                AutomationProperties.AutomationId="BannerAbortButton"
                AutomationProperties.Name="{Binding AbortText}" />
      </StackPanel>
    </local:BannerLayoutPanel>
  </Border>
</UserControl>
