<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:kr="using:VisualCommit.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VisualCommit.App.Controls"
             xmlns:cmd="using:VisualCommit.App.ViewModels.Commands"
             xmlns:vm="using:VisualCommit.App.ViewModels"
             xmlns:ws="using:VisualCommit.App.ViewModels.Workspaces"
             x:Class="VisualCommit.App.Views.Shell.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

  <!-- The welcome page of a tab without a repository (D42): under phase 0's "No repository open",
       Open, Clone and Init with the workspaces (docs/phase-6-design.md 13.1, D188) and the recent
       repositories, or the clone form with its progress. A long folder in an error breaks only
       after a separator (PathTextBlock, 13.2). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="440" VerticalAlignment="Center" Spacing="8">
      <TextBlock Text="No repository open"
                 FontSize="16" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Classes="secondary"
                 Text="Open, clone or init a repository to see its history."
                 TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" />

      <!-- Buttons and recent repositories. -->
      <StackPanel Name="WelcomeButtons" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding ShowsButtons}">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Name="OpenRepoButton" Theme="{StaticResource VcActionButton}"
                  kr:KeyRegion.IsMain="True"
                  Command="{Binding OpenCommand}"
                  ToolTip.Tip="{x:Static cmd:ShellToolTips.OpenRepository}"
                  AutomationProperties.HelpText="{x:Static cmd:ShellToolTips.OpenRepository}"
                  AutomationProperties.AcceleratorKey="{x:Static cmd:ShellToolTips.OpenRepositoryKey}"
                  AutomationProperties.AutomationId="OpenRepoButton"
                  AutomationProperties.Name="Open">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconFolderOpen}" Width="15" Height="15" />
              <TextBlock Text="Open" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="CloneRepoButton" Theme="{StaticResource VcActionButton}"
                  Command="{Binding OpenCloneFormCommand}"
                  ToolTip.Tip="{x:Static cmd:ShellToolTips.CloneRepository}"
                  AutomationProperties.HelpText="{x:Static cmd:ShellToolTips.CloneRepository}"
                  AutomationProperties.AcceleratorKey="{x:Static cmd:ShellToolTips.CloneRepositoryKey}"
                  AutomationProperties.AutomationId="CloneRepoButton"
                  AutomationProperties.Name="Clone">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconDownload}" Width="15" Height="15" />
              <TextBlock Text="Clone" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="InitRepoButton" Theme="{StaticResource VcActionButton}"
                  Command="{Binding InitCommand}"
                  ToolTip.Tip="{x:Static cmd:ShellToolTips.InitRepository}"
                  AutomationProperties.HelpText="{x:Static cmd:ShellToolTips.InitRepository}"
                  AutomationProperties.AcceleratorKey="{x:Static cmd:ShellToolTips.InitRepositoryKey}"
                  AutomationProperties.AutomationId="InitRepoButton"
                  AutomationProperties.Name="Init">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconFolderPlus}" Width="15" Height="15" />
              <TextBlock Text="Init" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <c:PathTextBlock Name="WelcomeError"
                         Classes="error"
                         Text="{Binding ErrorText}"
                         IsVisible="{Binding HasError}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         AutomationProperties.AutomationId="WelcomeError" />

        <!-- Workspaces (13.1): always shown, also with none, since it is where workspaces start.
             A heading row 19 high, 16 above it: the heading at the left, "New workspace…" at the
             right; the store's notice; then "No workspaces" or a row per workspace, by name. -->
        <DockPanel Name="WorkspacesHeadingRow" Margin="0,16,0,0">
          <Button Name="NewWorkspaceButton"
                  DockPanel.Dock="Right"
                  Theme="{StaticResource VcFlatButton}"
                  Padding="6,2"
                  Command="{Binding NewWorkspaceCommand}"
                  ToolTip.Tip="{Binding NewWorkspaceToolTip}"
                  AutomationProperties.HelpText="{Binding NewWorkspaceToolTip}"
                  AutomationProperties.AutomationId="NewWorkspaceButton"
                  AutomationProperties.Name="{x:Static ws:WorkspaceTexts.NewWorkspaceName}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:Icon Data="{StaticResource IconPlus}" Width="12" Height="12" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static ws:WorkspaceTexts.NewWorkspace}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Name="WorkspacesHeading"
                     Classes="heading"
                     VerticalAlignment="Center"
                     Text="{x:Static ws:WorkspaceTexts.Heading}"
                     AutomationProperties.AutomationId="WorkspacesHeading" />
        </DockPanel>
        <TextBlock Name="WorkspacesNotice"
                   Classes="secondary"
                   Classes.warning="{Binding IsWorkspacesNoticeWarning}"
                   Text="{Binding WorkspacesNotice}"
                   IsVisible="{Binding HasWorkspacesNotice}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="WorkspacesNotice" />
        <TextBlock Name="NoWorkspacesText"
                   Classes="secondary"
                   Text="{x:Static ws:WorkspaceTexts.NoWorkspaces}"
                   IsVisible="{Binding !HasWorkspaces}"
                   AutomationProperties.AutomationId="NoWorkspacesText" />
        <ItemsControl Name="WorkspaceList"
                      ItemsSource="{Binding Workspaces}"
                      IsVisible="{Binding HasWorkspaces}"
                      AutomationProperties.AutomationId="WorkspaceList"
                      AutomationProperties.Name="{x:Static ws:WorkspaceTexts.Heading}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ws:WorkspaceItem">
              <Button Name="WorkspaceItem"
                      Theme="{StaticResource VcFlatButton}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Padding="8,5"
                      Command="{Binding $parent[ItemsControl].((vm:WelcomeViewModel)DataContext).OpenWorkspaceCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{Binding ToolTipText}"
                      AutomationProperties.AutomationId="WorkspaceItem"
                      AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                  <TextBlock Name="WorkspaceItemCount"
                             DockPanel.Dock="Right"
                             Classes="secondary"
                             Text="{Binding CountText}"
                             Margin="12,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Name="WorkspaceItemName"
                             Text="{Binding Name}"
                             Foreground="{DynamicResource VcTextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="heading" Text="Recent repositories" Margin="0,16,0,0" />
        <TextBlock Classes="secondary"
                   Text="No recent repositories"
                   IsVisible="{Binding !HasRecent}" />
        <ItemsControl Name="RecentList" ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentRepositoryItem">
              <Button Theme="{StaticResource VcFlatButton}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Padding="8,5"
                      Command="{Binding $parent[ItemsControl].((vm:WelcomeViewModel)DataContext).OpenRecentCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{Binding Path}"
                      AutomationProperties.AutomationId="RecentRepository"
                      AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                  <TextBlock Text="{Binding Name}"
                             Foreground="{DynamicResource VcTextPrimaryBrush}"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
                  <TextBlock Classes="secondary"
                             Text="{Binding Path}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Clone form, in place of the buttons and the recent repositories. -->
      <StackPanel Name="CloneForm" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsCloneFormOpen}">
        <TextBlock Classes="heading" Text="Clone a repository" />

        <TextBlock Classes="secondary" Text="Repository URL" />
        <TextBox Name="CloneUrlBox"
                 Text="{Binding CloneUrl}"
                 IsEnabled="{Binding CanEditClone}"
                 AutomationProperties.AutomationId="CloneUrlBox"
                 AutomationProperties.Name="Repository URL" />

        <TextBlock Classes="secondary" Text="Parent folder" />
        <DockPanel>
          <Button Name="CloneBrowseButton"
                  DockPanel.Dock="Right"
                  Theme="{StaticResource VcActionButton}"
                  Margin="6,0,0,0" Padding="10,4"
                  Command="{Binding BrowseCloneParentCommand}"
                  IsEnabled="{Binding CanEditClone}"
                  AutomationProperties.AutomationId="CloneBrowseButton"
                  AutomationProperties.Name="Browse">
            <TextBlock Text="Browse" />
          </Button>
          <TextBox Name="CloneParentBox"
                   Text="{Binding CloneParent}"
                   IsEnabled="{Binding CanEditClone}"
                   AutomationProperties.AutomationId="CloneParentBox"
                   AutomationProperties.Name="Parent folder" />
        </DockPanel>

        <TextBlock Classes="secondary" Text="Folder name" />
        <TextBox Name="CloneNameBox"
                 Text="{Binding CloneName}"
                 IsEnabled="{Binding CanEditClone}"
                 AutomationProperties.AutomationId="CloneNameBox"
                 AutomationProperties.Name="Folder name" />

        <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding IsCloning}">
          <ProgressBar Name="CloneProgress"
                       Minimum="0" Maximum="100"
                       Value="{Binding CloneProgressValue}"
                       Height="6" MinHeight="6"
                       AutomationProperties.AutomationId="CloneProgress" />
          <TextBlock Name="CloneProgressText"
                     Classes="secondary"
                     Text="{Binding CloneProgressText}"
                     AutomationProperties.AutomationId="CloneProgressText" />
        </StackPanel>

        <c:PathTextBlock Name="CloneError"
                         Classes="error"
                         Text="{Binding ErrorText}"
                         IsVisible="{Binding HasError}"
                         TextWrapping="Wrap"
                         AutomationProperties.AutomationId="CloneError" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <Button Name="CloneStartButton"
                  Theme="{StaticResource VcActionButton}"
                  Command="{Binding StartCloneCommand}"
                  AutomationProperties.AutomationId="CloneStartButton"
                  AutomationProperties.Name="Clone">
            <TextBlock Text="Clone" />
          </Button>
          <Button Name="CloneCancelButton"
                  Theme="{StaticResource VcActionButton}"
                  Command="{Binding CancelCloneCommand}"
                  IsVisible="{Binding IsCloning}"
                  AutomationProperties.AutomationId="CloneCancelButton"
                  AutomationProperties.Name="Cancel">
            <TextBlock Text="Cancel" />
          </Button>
          <Button Name="CloneCloseButton"
                  Theme="{StaticResource VcActionButton}"
                  Command="{Binding CloseCloneFormCommand}"
                  IsVisible="{Binding CanEditClone}"
                  AutomationProperties.AutomationId="CloneCloseButton"
                  AutomationProperties.Name="Cancel">
            <TextBlock Text="Cancel" />
          </Button>
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <!-- A failed save of workspaces.json is said in the warning tone (13.1). -->
    <Style Selector="TextBlock#WorkspacesNotice.warning">
      <Setter Property="Foreground" Value="{DynamicResource VcWarningBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
