<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisualCommit.App.ViewModels.Dialogs"
             x:Class="VisualCommit.App.Views.Dialogs.PassphraseView"
             x:DataType="vm:PassphraseViewModel"
             AutomationProperties.AutomationId="PassphraseDialog"
             AutomationProperties.Name="{Binding Title}">

  <!-- "Key passphrase" (docs/phase-3-design.md 3.2, 4f; check 21b): ssh asks for a key's passphrase. -->
  <Panel Background="{DynamicResource VcBackdropBrush}">
    <Border Name="PassphraseCard"
            KeyboardNavigation.TabNavigation="Cycle"
            MaxWidth="400"
            Margin="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{DynamicResource VcPanelBackgroundBrush}"
            BorderBrush="{DynamicResource VcBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20">
      <StackPanel>
        <TextBlock Name="DialogTitle"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="DialogTitle" />
        <TextBlock Name="DialogRepository"
                   Classes="secondary"
                   Text="{Binding RepositoryLine}"
                   IsVisible="{Binding HasRepositoryLine}"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="DialogRepository" />
        <TextBlock Name="PassphraseText"
                   Text="{Binding Text}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="PassphraseText" />
        <TextBox Name="PassphraseBox"
                 Text="{Binding Passphrase}"
                 PasswordChar="{x:Static vm:PromptDialogViewModel.MaskCharacter}"
                 Margin="0,12,0,0"
                 AutomationProperties.AutomationId="PassphraseBox"
                 AutomationProperties.Name="Passphrase" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0" HorizontalAlignment="Right">
          <Button Name="CancelButton"
                  Theme="{StaticResource VcActionButton}"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.AutomationId="CancelButton"
                  AutomationProperties.Name="Cancel" />
          <Button Name="ConfirmButton"
                  Theme="{StaticResource VcPrimaryButton}"
                  Content="{Binding ConfirmText}"
                  Command="{Binding ConfirmCommand}"
                  AutomationProperties.AutomationId="ConfirmButton"
                  AutomationProperties.Name="{Binding ConfirmText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
