<local:DialogView xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:VisualCommit.App.Views.Dialogs"
                  xmlns:vm="using:VisualCommit.App.ViewModels.Dialogs"
                  xmlns:ops="using:VisualCommit.App.ViewModels.Operations"
                  x:Class="VisualCommit.App.Views.Dialogs.CreatePullRequestDialogView"
                  x:DataType="vm:CreatePullRequestDialogViewModel"
                  AutomationProperties.AutomationId="CreatePullRequestDialog"
                  AutomationProperties.Name="{Binding Title}">

  <!-- The "Create pull request" form (docs/phase-7a-design.md 12.4; D312, D318) on the wide card
       (460): From the head, its repository and the note of what Create pushes first; Into the base,
       its repository and Choose... (as the merge tool's row); the title (32 high, focused, the caret
       at its end, Enter creates), the description (120 high, Mod+Enter creates), Draft, the error
       line and "Open pull request #n", then Cancel and Create. While creating every control is
       disabled but Cancel within the create's cancel window (ruling 59). docs/phase-7b-design.md
       13.4: the From and Into rows are DockPanels sized to their content, which place each child
       where 7a's Spacing="8" did; past the column a repository text is cut with "...", its whole
       text its tooltip (ruling 3). GitLab's two lines, collapsed otherwise: the title GitLab is
       sent under Draft while it is ticked, and the quick-actions note under the description. -->
  <Panel Classes="dialogBackdrop">
    <Border Name="CreatePullRequestDialogCard" Classes="dialogCard wide">
      <StackPanel>
        <TextBlock Name="CreatePullRequestDialogTitle"
                   Classes="dialogTitle"
                   Text="{Binding Title}"
                   AutomationProperties.AutomationId="CreatePullRequestDialogTitle" />
        <TextBlock Name="DialogRepository"
                   Classes="dialogRepository"
                   Text="{Binding RepositoryText}"
                   IsVisible="{Binding ShowsRepository}"
                   AutomationProperties.AutomationId="DialogRepository" />
        <Grid ColumnDefinitions="48,*" RowDefinitions="Auto,Auto" Margin="0,14,0,0">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="secondary"
                     Text="{x:Static ops:OperationTexts+CreatePullRequestTexts.From}"
                     VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1">
            <DockPanel HorizontalAlignment="Left">
              <TextBlock Name="PullRequestHead"
                         DockPanel.Dock="Left"
                         Text="{Binding Head.Text}"
                         MaxWidth="220"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Head.Text}"
                         AutomationProperties.AutomationId="PullRequestHead" />
              <local:RowRepositoryText Name="PullRequestHeadRepository" Classes="secondary"
                         Text="{Binding Head.Repository}"
                         Margin="8,0,0,0"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Head.Repository}"
                         AutomationProperties.AutomationId="PullRequestHeadRepository" />
            </DockPanel>
            <TextBlock Name="PullRequestHeadNote" Classes="settingsNote"
                       Text="{Binding HeadNote}"
                       IsVisible="{Binding HasHeadNote}"
                       AutomationProperties.AutomationId="PullRequestHeadNote" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" Classes="secondary"
                     Text="{x:Static ops:OperationTexts+CreatePullRequestTexts.Into}"
                     Margin="0,8,0,0" VerticalAlignment="Center" />
          <DockPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,8,0,0">
            <TextBlock Name="PullRequestBase"
                       DockPanel.Dock="Left"
                       Text="{Binding BaseText}"
                       Classes.secondary="{Binding IsReadingBase}"
                       MaxWidth="220"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding BaseText}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="PullRequestBase" />
            <Button Name="PullRequestBaseChooseButton" Theme="{StaticResource VcActionButton}"
                    DockPanel.Dock="Right"
                    Content="{x:Static ops:OperationTexts+SettingsTexts.Choose}"
                    Command="{Binding ChooseBaseCommand}"
                    AutomationProperties.AutomationId="PullRequestBaseChooseButton"
                    AutomationProperties.Name="{x:Static ops:OperationTexts+SettingsTexts.Choose}" />
            <local:RowRepositoryText Name="PullRequestBaseRepository" Classes="secondary"
                       Text="{Binding BaseRepository}"
                       Margin="8,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding BaseRepository}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="PullRequestBaseRepository" />
          </DockPanel>
        </Grid>
        <TextBox Name="PullRequestTitle"
                 Classes="dialogBox"
                 Text="{Binding PullRequestTitle}"
                 PlaceholderText="{x:Static ops:OperationTexts+CreatePullRequestTexts.TitlePlaceholder}"
                 IsEnabled="{Binding IsIdle}"
                 Height="32"
                 VerticalContentAlignment="Center"
                 AutomationProperties.AutomationId="PullRequestTitle"
                 AutomationProperties.Name="{x:Static ops:OperationTexts+CreatePullRequestTexts.TitlePlaceholder}" />
        <TextBox Name="PullRequestDescription"
                 Text="{Binding Description}"
                 PlaceholderText="{x:Static ops:OperationTexts+CreatePullRequestTexts.DescriptionPlaceholder}"
                 IsEnabled="{Binding IsIdle}"
                 Height="120"
                 Margin="0,8,0,0"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 AutomationProperties.AutomationId="PullRequestDescription"
                 AutomationProperties.Name="{x:Static ops:OperationTexts+CreatePullRequestTexts.DescriptionPlaceholder}" />
        <TextBlock Name="PullRequestQuickActionsNote" Classes="settingsNote"
                   Text="{Binding QuickActionsNote}"
                   IsVisible="{Binding ShowsQuickActionsNote}"
                   Margin="0,4,0,0"
                   AutomationProperties.AutomationId="PullRequestQuickActionsNote" />
        <CheckBox Name="PullRequestDraft"
                  Theme="{StaticResource VcCheckBox}"
                  Content="{x:Static ops:OperationTexts+CreatePullRequestTexts.Draft}"
                  IsChecked="{Binding IsDraft}"
                  IsEnabled="{Binding IsIdle}"
                  Margin="0,12,0,0"
                  AutomationProperties.AutomationId="PullRequestDraft"
                  AutomationProperties.Name="{x:Static ops:OperationTexts+CreatePullRequestTexts.Draft}" />
        <TextBlock Name="PullRequestSentTitle" Classes="settingsNote"
                   Text="{Binding SentTitle}"
                   IsVisible="{Binding ShowsSentTitle}"
                   Margin="0,4,0,0"
                   AutomationProperties.AutomationId="PullRequestSentTitle" />
        <TextBlock Name="PullRequestError"
                   Classes="dialogError"
                   Text="{Binding Error}"
                   IsVisible="{Binding HasError}"
                   AutomationProperties.AutomationId="PullRequestError" />
        <Button Name="PullRequestOpenExisting"
                Theme="{StaticResource VcActionButton}"
                Content="{Binding OpenExistingText}"
                Command="{Binding OpenExistingCommand}"
                IsVisible="{Binding HasExisting}"
                HorizontalAlignment="Left"
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="PullRequestOpenExisting"
                AutomationProperties.Name="{Binding OpenExistingText}" />
        <StackPanel Classes="dialogButtons">
          <Button Name="CancelButton"
                  Theme="{StaticResource VcActionButton}"
                  Content="Cancel"
                  Command="{Binding CancelFormCommand}"
                  AutomationProperties.AutomationId="CancelButton"
                  AutomationProperties.Name="Cancel" />
          <Button Name="ConfirmButton"
                  Theme="{StaticResource VcPrimaryButton}"
                  Content="{Binding CreateText}"
                  Command="{Binding CreateCommand}"
                  ToolTip.Tip="{Binding CreateToolTip}"
                  ToolTip.ShowOnDisabled="True"
                  AutomationProperties.AutomationId="ConfirmButton"
                  AutomationProperties.Name="{Binding CreateText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</local:DialogView>
