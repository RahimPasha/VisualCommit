<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VisualCommit.App.ViewModels.Dialogs"
             x:Class="VisualCommit.App.Views.Dialogs.ConfirmationView"
             x:DataType="vm:ConfirmationViewModel"
             AutomationProperties.AutomationId="ConfirmationDialog">

  <!-- A confirmation over the whole window (D69), as "The confirmation dialog" in
       docs/test-reports/phase-2.md describes it: the backdrop, and a card in the middle. -->
  <Panel Background="{DynamicResource VcBackdropBrush}">
    <Border Name="ConfirmationCard"
            MaxWidth="400"
            Margin="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{DynamicResource VcPanelBackgroundBrush}"
            BorderBrush="{DynamicResource VcBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20">
      <StackPanel>
        <TextBlock Name="ConfirmTitle"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ConfirmTitle" />
        <TextBlock Name="ConfirmQuestion"
                   Text="{Binding Question}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ConfirmQuestion" />
        <TextBlock Name="ConfirmDetail"
                   Classes="secondary"
                   Text="{Binding Detail}"
                   IsVisible="{Binding HasDetail}"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ConfirmDetail" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0" HorizontalAlignment="Right">
          <Button Name="CancelButton"
                  Theme="{StaticResource VcActionButton}"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.AutomationId="CancelButton"
                  AutomationProperties.Name="Cancel" />
          <Button Name="ConfirmButton"
                  Theme="{StaticResource VcDangerButton}"
                  Content="{Binding ConfirmText}"
                  Command="{Binding ConfirmCommand}"
                  AutomationProperties.AutomationId="ConfirmButton"
                  AutomationProperties.Name="{Binding ConfirmText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
