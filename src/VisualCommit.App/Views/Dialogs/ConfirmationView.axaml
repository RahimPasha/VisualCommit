<local:DialogView xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:VisualCommit.App.Views.Dialogs"
                  xmlns:c="using:VisualCommit.App.Controls"
                  xmlns:vm="using:VisualCommit.App.ViewModels.Dialogs"
                  x:Class="VisualCommit.App.Views.Dialogs.ConfirmationView"
                  x:DataType="vm:ConfirmationViewModel"
                  AutomationProperties.AutomationId="ConfirmationDialog"
                  AutomationProperties.Name="{Binding Title}">

  <!-- A confirmation over the whole window (D69), as "The confirmation dialog" in
       docs/test-reports/phase-2.md describes it: the backdrop, and a card in the middle. Tab
       goes round the card's buttons and never to the window behind. Phase 3 reuses it for every
       question of its operations (docs/phase-3-design.md 2, 4f): the button that goes ahead has
       the danger style for a destructive one, the primary style otherwise (ssh's "Yes", D115). -->
  <Panel Classes="dialogBackdrop">
    <Border Name="ConfirmationCard" Classes="dialogCard">
      <StackPanel>
        <TextBlock Name="ConfirmTitle"
                   Classes="dialogTitle"
                   Text="{Binding Title}"
                   AutomationProperties.AutomationId="ConfirmTitle" />
        <TextBlock Name="DialogRepository"
                   Classes="dialogRepository"
                   Text="{Binding RepositoryText}"
                   IsVisible="{Binding ShowsRepository}"
                   AutomationProperties.AutomationId="DialogRepository" />
        <c:UrlTextBlock Name="ConfirmQuestion"
                   Text="{Binding Question}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ConfirmQuestion" />
        <TextBlock Name="ConfirmDetail"
                   Classes="secondary"
                   Text="{Binding Detail}"
                   IsVisible="{Binding HasDetail}"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ConfirmDetail" />
        <StackPanel Classes="dialogButtons">
          <Button Name="CancelButton"
                  Theme="{StaticResource VcActionButton}"
                  Content="{Binding CancelText}"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.AutomationId="CancelButton"
                  AutomationProperties.Name="{Binding CancelText}" />
          <Button Name="ConfirmButton"
                  Classes.danger="{Binding IsDestructive}"
                  Content="{Binding ConfirmText}"
                  Command="{Binding ConfirmCommand}"
                  AutomationProperties.AutomationId="ConfirmButton"
                  AutomationProperties.Name="{Binding ConfirmText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>

  <local:DialogView.Styles>
    <Style Selector="Button#ConfirmButton">
      <Setter Property="Theme" Value="{StaticResource VcPrimaryButton}" />
    </Style>
    <Style Selector="Button#ConfirmButton.danger">
      <Setter Property="Theme" Value="{StaticResource VcDangerButton}" />
    </Style>
  </local:DialogView.Styles>
</local:DialogView>
