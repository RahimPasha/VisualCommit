<local:DialogView xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:VisualCommit.App.Views.Dialogs"
                  xmlns:vm="using:VisualCommit.App.ViewModels.Dialogs"
                  x:Class="VisualCommit.App.Views.Dialogs.HostKeyView"
                  x:DataType="vm:HostKeyViewModel"
                  AutomationProperties.AutomationId="HostKeyDialog"
                  AutomationProperties.Name="{Binding Title}">

  <!-- "Unknown host" (docs/phase-3-design.md 3.2, 4f; check 21b): ssh's question about a host key
       it does not know, its lines in the code font. -->
  <Panel Classes="dialogBackdrop">
    <Border Name="HostKeyCard" Classes="dialogCard">
      <StackPanel>
        <TextBlock Name="DialogTitle"
                   Classes="dialogTitle"
                   Text="{Binding Title}"
                   AutomationProperties.AutomationId="DialogTitle" />
        <TextBlock Name="DialogRepository"
                   Classes="dialogRepository"
                   Text="{Binding RepositoryText}"
                   IsVisible="{Binding ShowsRepository}"
                   AutomationProperties.AutomationId="DialogRepository" />
        <Border Margin="0,12,0,0"
                Padding="10,8"
                CornerRadius="5"
                Background="{DynamicResource VcControlBackgroundBrush}"
                BorderBrush="{DynamicResource VcBorderBrush}"
                BorderThickness="1">
          <SelectableTextBlock Name="HostKeyText"
                               Text="{Binding Text}"
                               FontFamily="{StaticResource VcCodeFontFamily}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="HostKeyText" />
        </Border>
        <TextBlock Name="HostKeyQuestion"
                   Classes="dialogText"
                   Text="{Binding Question}"
                   AutomationProperties.AutomationId="HostKeyQuestion" />

        <StackPanel Classes="dialogButtons">
          <Button Name="CancelButton"
                  Theme="{StaticResource VcActionButton}"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.AutomationId="CancelButton"
                  AutomationProperties.Name="Cancel" />
          <Button Name="ConfirmButton"
                  Theme="{StaticResource VcPrimaryButton}"
                  Content="{Binding ConfirmText}"
                  Command="{Binding ConfirmCommand}"
                  AutomationProperties.AutomationId="ConfirmButton"
                  AutomationProperties.Name="{Binding ConfirmText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</local:DialogView>
