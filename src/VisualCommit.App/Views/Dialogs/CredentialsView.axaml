<local:DialogView xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:VisualCommit.App.Views.Dialogs"
                  xmlns:c="using:VisualCommit.App.Controls"
                  xmlns:vm="using:VisualCommit.App.ViewModels.Dialogs"
                  x:Class="VisualCommit.App.Views.Dialogs.CredentialsView"
                  x:DataType="vm:CredentialsViewModel"
                  AutomationProperties.AutomationId="CredentialsDialog"
                  AutomationProperties.Name="{Binding Title}">

  <!-- "Sign in to <host>" (docs/phase-3-design.md 3.2, 4f; check 21): git's user name and
       password prompts. The password typed here answers git's password prompt that follows. -->
  <local:DialogView.Styles>
    <Style Selector="TextBlock.promptLabel">
      <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </local:DialogView.Styles>

  <Panel Classes="dialogBackdrop">
    <Border Name="CredentialsCard" Classes="dialogCard">
      <StackPanel>
        <TextBlock Name="DialogTitle"
                   Classes="dialogTitle"
                   Text="{Binding Title}"
                   AutomationProperties.AutomationId="DialogTitle" />
        <TextBlock Name="DialogRepository"
                   Classes="dialogRepository"
                   Text="{Binding RepositoryText}"
                   IsVisible="{Binding ShowsRepository}"
                   AutomationProperties.AutomationId="DialogRepository" />
        <c:UrlTextBlock Name="CredentialsText"
                   Classes="dialogText"
                   Text="{Binding Text}"
                   AutomationProperties.AutomationId="CredentialsText" />

        <TextBlock Classes="promptLabel" Text="User name" />
        <TextBox Name="CredentialUsername"
                 Text="{Binding UserName}"
                 IsVisible="{Binding IsUserEditable}"
                 AutomationProperties.AutomationId="CredentialUsername"
                 AutomationProperties.Name="User name" />
        <TextBlock Name="CredentialUser"
                   Text="{Binding UserName}"
                   IsVisible="{Binding IsUserShown}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="CredentialUser" />

        <TextBlock Classes="promptLabel" Text="Password" />
        <c:SecretTextBox Name="CredentialPassword"
                 Text="{Binding Password}"
                 PasswordChar="{x:Static vm:PromptDialogViewModel.MaskCharacter}"
                 AutomationProperties.AutomationId="CredentialPassword"
                 AutomationProperties.Name="Password" />

        <StackPanel Classes="dialogButtons">
          <Button Name="CancelButton"
                  Theme="{StaticResource VcActionButton}"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.AutomationId="CancelButton"
                  AutomationProperties.Name="Cancel" />
          <Button Name="ConfirmButton"
                  Theme="{StaticResource VcPrimaryButton}"
                  Content="{Binding ConfirmText}"
                  Command="{Binding ConfirmCommand}"
                  AutomationProperties.AutomationId="ConfirmButton"
                  AutomationProperties.Name="{Binding ConfirmText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</local:DialogView>
