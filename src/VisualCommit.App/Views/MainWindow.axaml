<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VisualCommit.App.ViewModels"
        xmlns:shell="using:VisualCommit.App.Views.Shell"
        xmlns:dialogs="using:VisualCommit.App.Views.Dialogs"
        x:Class="VisualCommit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VisualCommit"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource VcWindowBackgroundBrush}"
        Foreground="{DynamicResource VcTextPrimaryBrush}"
        FontSize="12.5">

  <!-- The layout follows "Main window layout" in docs/requirements.md:
       repo tabs, toolbar, left panel | commit graph | right panel, status bar. A dialog, when one
       is open, lies over all of it (D69). -->
  <Panel>
  <Grid RowDefinitions="36,52,*,26">

    <shell:RepoTabsView Grid.Row="0" />
    <shell:ToolbarView Grid.Row="1" />

    <Grid Name="MainArea" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="180" MaxWidth="520" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="400" MinWidth="280" MaxWidth="720" />
      </Grid.ColumnDefinitions>

      <!-- The three regions show the active tab (D45). -->
      <shell:LeftPanelView Grid.Column="0" DataContext="{Binding ActiveTab.LeftPanel}" />
      <shell:CommitGraphView Grid.Column="1" DataContext="{Binding ActiveTab}" />
      <!-- The commit's details, or the stage panel while the working-changes row is selected. -->
      <Panel Grid.Column="2" IsVisible="{Binding !ActiveTab.ShowsWorkingChanges}">
        <shell:RightPanelView DataContext="{Binding ActiveTab.Details}" />
      </Panel>
      <Panel Grid.Column="2" IsVisible="{Binding ActiveTab.ShowsWorkingChanges}">
        <shell:WorkingChangesView DataContext="{Binding ActiveTab.Changes}" />
      </Panel>

      <!-- The splitters lie over the panel edges: a 7-wide grab area centred on the 1-wide
           border line that each panel draws itself. -->
      <GridSplitter Name="LeftSplitter"
                    Grid.Column="0"
                    Width="7" Margin="0,0,-3,0"
                    HorizontalAlignment="Right"
                    ResizeBehavior="CurrentAndNext"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    ZIndex="1"
                    AutomationProperties.AutomationId="LeftSplitter" />
      <GridSplitter Name="RightSplitter"
                    Grid.Column="2"
                    Width="7" Margin="-3,0,0,0"
                    HorizontalAlignment="Left"
                    ResizeBehavior="PreviousAndCurrent"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    ZIndex="1"
                    AutomationProperties.AutomationId="RightSplitter" />
    </Grid>

    <shell:StatusBarView Grid.Row="3" />

  </Grid>
  <Panel IsVisible="{Binding Dialogs.IsOpen}">
    <dialogs:ConfirmationView DataContext="{Binding Dialogs.Current}" />
  </Panel>
  </Panel>
</Window>
