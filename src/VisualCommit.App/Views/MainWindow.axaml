<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VisualCommit.App.ViewModels"
        xmlns:shell="using:VisualCommit.App.Views.Shell"
        xmlns:dialogs="using:VisualCommit.App.Views.Dialogs"
        x:Class="VisualCommit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VisualCommit"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource VcWindowBackgroundBrush}"
        Foreground="{DynamicResource VcTextPrimaryBrush}"
        FontSize="12.5">

  <!-- The layout follows "Main window layout" in docs/requirements.md:
       repo tabs, toolbar, left panel | commit graph | right panel, status bar. A dialog, when one
       is open, lies over all of it (D69). -->
  <Panel>
  <Grid RowDefinitions="36,52,*,26">

    <shell:RepoTabsView Grid.Row="0" />
    <shell:ToolbarView Grid.Row="1" />

    <Grid Name="MainArea" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="180" MaxWidth="520" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="400" MinWidth="280" MaxWidth="720" />
      </Grid.ColumnDefinitions>

      <!-- The three regions show the active tab (D45). A dashboard spans all three columns while
           the side panels and splitters hide, their widths untouched (docs/phase-6-design.md 2.4). -->
      <Panel Grid.Column="0" IsVisible="{Binding ActiveTab.ShowsLeftPanel}">
        <shell:LeftPanelView DataContext="{Binding ActiveTab.LeftPanel}" />
      </Panel>
      <!-- While the conflict resolver is open the graph area spans the right panel's column too,
           which keeps its width (docs/phase-4-design.md 11.2). -->
      <shell:CommitGraphView Grid.Column="{Binding GraphColumn}" DataContext="{Binding ActiveTab}" Grid.ColumnSpan="{Binding GraphColumnSpan}" />
      <!-- The commit's details, or the stage panel while the working-changes row is selected. -->
      <Panel Grid.Column="2" IsVisible="{Binding ActiveTab.ShowsDetailsPanel}">
        <shell:RightPanelView DataContext="{Binding ActiveTab.Details}" />
      </Panel>
      <Panel Grid.Column="2" IsVisible="{Binding ActiveTab.ShowsStagePanel}">
        <shell:WorkingChangesView DataContext="{Binding ActiveTab.Changes}" />
      </Panel>

      <!-- The splitters lie over the panel edges: a 7-wide grab area centred on the 1-wide
           border line that each panel draws itself. -->
      <GridSplitter Name="LeftSplitter"
                    Grid.Column="0"
                    Width="7" Margin="0,0,-3,0"
                    HorizontalAlignment="Right"
                    ResizeBehavior="CurrentAndNext"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    ZIndex="1"
                    IsVisible="{Binding ActiveTab.ShowsLeftPanel}"
                    AutomationProperties.AutomationId="LeftSplitter" />
      <GridSplitter Name="RightSplitter"
                    Grid.Column="2"
                    Width="7" Margin="-3,0,0,0"
                    HorizontalAlignment="Left"
                    ResizeBehavior="PreviousAndCurrent"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    ZIndex="1"
                    IsVisible="{Binding ActiveTab.ShowsRightPanel}"
                    AutomationProperties.AutomationId="RightSplitter" />
    </Grid>

    <shell:StatusBarView Grid.Row="3" />

  </Grid>

  <!-- The in-window context menu (docs/phase-3-design.md 4a), over the main grid and under the
       dialogs; and the layer a dragged branch is drawn on (4g), which takes no input. Both are
       empty until WP5 and WP8 fill them. -->
  <shell:MenuLayer Name="MenuLayer" DataContext="{Binding Menu}" />
  <shell:DragLayer Name="DragLayer" />

  <!-- The dialog layer (D69): the open dialogs, the bottom one first, each over a backdrop of its
       own, so that a dialog opened over another covers it (D104). The view of each is found by
       its view model's type. -->
  <ItemsControl Name="DialogLayer"
                ItemsSource="{Binding Dialogs.Open}"
                IsVisible="{Binding Dialogs.IsOpen}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <Panel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <dialogs:DialogViewLocator />
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  </Panel>
</Window>
