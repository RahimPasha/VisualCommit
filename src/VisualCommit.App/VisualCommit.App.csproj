<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VisualCommit</AssemblyName>
    <RootNamespace>VisualCommit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icon\VisualCommit.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
  </ItemGroup>

  <ItemGroup>
    <!-- JetBrains Mono NL, the typeface of code in the diff view (D64; OFL, see THIRD-PARTY-NOTICES.md). -->
    <AvaloniaResource Include="Assets\Fonts\**" />
    <!-- The app's icon (D407): the .ico of the windows and the executable, and the mark at 48 and
         96 pixels. Made from the SVG masters in assets/brand/ by tools/VisualCommit.IconBuilder,
         never by hand; run it again after a master changes and commit what it writes. -->
    <AvaloniaResource Include="Assets\Icon\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The texts About shows (D431, D433), embedded word for word so that nothing lies beside
         the executable: the app's license, the third-party notices and each vendor's notice file.
         EmbeddedTexts names them; ThirdPartyNoticesTests holds them to the repository's files. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="VisualCommit.License.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="VisualCommit.ThirdPartyNotices.md" />
    <EmbeddedResource Include="..\..\notices\*" LogicalName="VisualCommit.Notices.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisualCommit.Core\VisualCommit.Core.csproj" />
    <ProjectReference Include="..\VisualCommit.Git\VisualCommit.Git.csproj" />
    <ProjectReference Include="..\VisualCommit.Hosting\VisualCommit.Hosting.csproj" />
  </ItemGroup>

</Project>
