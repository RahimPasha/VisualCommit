<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The colour tokens of the two themes. Views use the brushes through DynamicResource, never
       hard-coded colours, so that switching the theme recolours everything. The table in
       docs/architecture.md lists these tokens; keep the two in step. -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="VcWindowBackgroundBrush" Color="#14161B" />
      <SolidColorBrush x:Key="VcPanelBackgroundBrush" Color="#1A1D24" />
      <SolidColorBrush x:Key="VcChromeBackgroundBrush" Color="#20242C" />
      <SolidColorBrush x:Key="VcControlBackgroundBrush" Color="#272C36" />
      <SolidColorBrush x:Key="VcHoverBackgroundBrush" Color="#2F3542" />
      <SolidColorBrush x:Key="VcBorderBrush" Color="#323845" />
      <SolidColorBrush x:Key="VcTextPrimaryBrush" Color="#E4E7EC" />
      <SolidColorBrush x:Key="VcTextSecondaryBrush" Color="#9BA3B0" />
      <SolidColorBrush x:Key="VcTextDisabledBrush" Color="#5F6775" />
      <SolidColorBrush x:Key="VcAccentBrush" Color="#7C8CFF" />
      <SolidColorBrush x:Key="VcAccentTextBrush" Color="#10121A" />
      <SolidColorBrush x:Key="VcSuccessBrush" Color="#3FB97F" />
      <SolidColorBrush x:Key="VcWarningBrush" Color="#E0A23B" />
      <SolidColorBrush x:Key="VcDangerBrush" Color="#E5606B" />
      <!-- Commit graph: rows, labels and the lane palette (D48). -->
      <SolidColorBrush x:Key="VcSelectionBrush" Color="#2A3150" />
      <SolidColorBrush x:Key="VcRowHoverBrush" Color="#1C1F27" />
      <SolidColorBrush x:Key="VcLabelTextBrush" Color="#10121A" />
      <SolidColorBrush x:Key="VcLane0Brush" Color="#7C8CFF" />
      <SolidColorBrush x:Key="VcLane1Brush" Color="#3FB97F" />
      <SolidColorBrush x:Key="VcLane2Brush" Color="#E0A23B" />
      <SolidColorBrush x:Key="VcLane3Brush" Color="#E5606B" />
      <SolidColorBrush x:Key="VcLane4Brush" Color="#4FB3D9" />
      <SolidColorBrush x:Key="VcLane5Brush" Color="#B07CE8" />
      <SolidColorBrush x:Key="VcLane6Brush" Color="#D97EB6" />
      <SolidColorBrush x:Key="VcLane7Brush" Color="#8FB84A" />
      <!-- Diff view (phase 2): rows, changed words, hunk headers, fillers; the dialog's backdrop. -->
      <SolidColorBrush x:Key="VcDiffAddedBrush" Color="#1A2E24" />
      <SolidColorBrush x:Key="VcDiffAddedWordBrush" Color="#2B5A3F" />
      <SolidColorBrush x:Key="VcDiffRemovedBrush" Color="#331D23" />
      <SolidColorBrush x:Key="VcDiffRemovedWordBrush" Color="#6A2D37" />
      <SolidColorBrush x:Key="VcDiffHunkBrush" Color="#1C2130" />
      <SolidColorBrush x:Key="VcDiffFillerBrush" Color="#181A20" />
      <SolidColorBrush x:Key="VcBackdropBrush" Color="#99000000" />
      <!-- Text boxes: these keys replace the Fluent theme's own colours for them. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#272C36" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#272C36" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#272C36" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#323845" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5F6775" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7C8CFF" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#E4E7EC" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E4E7EC" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E4E7EC" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9BA3B0" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9BA3B0" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#9BA3B0" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="VcWindowBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="VcPanelBackgroundBrush" Color="#F5F6F8" />
      <SolidColorBrush x:Key="VcChromeBackgroundBrush" Color="#EBEDF1" />
      <SolidColorBrush x:Key="VcControlBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="VcHoverBackgroundBrush" Color="#DEE2E9" />
      <SolidColorBrush x:Key="VcBorderBrush" Color="#D2D6DE" />
      <SolidColorBrush x:Key="VcTextPrimaryBrush" Color="#1B1F27" />
      <SolidColorBrush x:Key="VcTextSecondaryBrush" Color="#5C6572" />
      <SolidColorBrush x:Key="VcTextDisabledBrush" Color="#A1A8B3" />
      <SolidColorBrush x:Key="VcAccentBrush" Color="#4353D8" />
      <SolidColorBrush x:Key="VcAccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="VcSuccessBrush" Color="#1E8E5A" />
      <SolidColorBrush x:Key="VcWarningBrush" Color="#B7791F" />
      <SolidColorBrush x:Key="VcDangerBrush" Color="#C93A46" />
      <!-- Commit graph: rows, labels and the lane palette (D48). -->
      <SolidColorBrush x:Key="VcSelectionBrush" Color="#DDE1FA" />
      <SolidColorBrush x:Key="VcRowHoverBrush" Color="#F3F4F7" />
      <SolidColorBrush x:Key="VcLabelTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="VcLane0Brush" Color="#4353D8" />
      <SolidColorBrush x:Key="VcLane1Brush" Color="#1E8E5A" />
      <SolidColorBrush x:Key="VcLane2Brush" Color="#B7791F" />
      <SolidColorBrush x:Key="VcLane3Brush" Color="#C93A46" />
      <SolidColorBrush x:Key="VcLane4Brush" Color="#1F86B0" />
      <SolidColorBrush x:Key="VcLane5Brush" Color="#8048C7" />
      <SolidColorBrush x:Key="VcLane6Brush" Color="#B54A8C" />
      <SolidColorBrush x:Key="VcLane7Brush" Color="#5F8A1E" />
      <!-- Diff view (phase 2): rows, changed words, hunk headers, fillers; the dialog's backdrop. -->
      <SolidColorBrush x:Key="VcDiffAddedBrush" Color="#E6F6EC" />
      <SolidColorBrush x:Key="VcDiffAddedWordBrush" Color="#B4E5C6" />
      <SolidColorBrush x:Key="VcDiffRemovedBrush" Color="#FBE9EB" />
      <SolidColorBrush x:Key="VcDiffRemovedWordBrush" Color="#F3BAC1" />
      <SolidColorBrush x:Key="VcDiffHunkBrush" Color="#EEF0FB" />
      <SolidColorBrush x:Key="VcDiffFillerBrush" Color="#F3F4F6" />
      <SolidColorBrush x:Key="VcBackdropBrush" Color="#66000000" />
      <!-- Text boxes: these keys replace the Fluent theme's own colours for them. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D2D6DE" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A1A8B3" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4353D8" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#1B1F27" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1B1F27" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1B1F27" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5C6572" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#5C6572" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5C6572" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- The typeface of code in the diff view, shipped with the app (D64). -->
  <FontFamily x:Key="VcCodeFontFamily">avares://VisualCommit/Assets/Fonts#JetBrains Mono NL</FontFamily>

  <!-- Sizes shared by both themes. -->
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
  <Thickness x:Key="TextControlThemePadding">8,5,6,5</Thickness>

</ResourceDictionary>
