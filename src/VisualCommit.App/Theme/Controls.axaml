<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VisualCommit.App.Controls">

  <!-- Control themes and shared styles. Colours come from Theme/Tokens.axaml. -->

  <Styles.Resources>

    <!-- Toolbar button: icon above label. -->
    <ControlTheme x:Key="{x:Type c:ToolbarButton}" TargetType="c:ToolbarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="Padding" Value="6,5,6,4" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <!-- Screen readers and UI Automation read the label as the button's name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Spacing="3">
              <c:Icon Data="{TemplateBinding IconData}" Width="18" Height="18" HorizontalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Label}" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>

    <!-- A small button with no frame, for an icon or a short text in the tab strip and status bar. -->
    <ControlTheme x:Key="VcFlatButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
      <!-- On (docs/phase-5-design.md 1.2: the status bar's Activity log while its panel is open):
           primary text on the control background, which the hover look does not have. -->
      <Style Selector="^.selected">
        <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>

    <!-- The body of a repo tab: its title, left-aligned, filling the tab. The tab's own Border
         draws the background, so the button only shows the pointer over it. -->
    <ControlTheme x:Key="VcTabButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="Padding" Value="14,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- A button with an icon and a label in a row, for the welcome page and forms. -->
    <ControlTheme x:Key="VcActionButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource VcPanelBackgroundBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>


    <!-- A small text button: Flat and Tree (the one in use with the selection background, class
         "selected"), and the stage panel's and diff view's actions. -->
    <ControlTheme x:Key="FileListToggle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
      <Style Selector="^.selected">
        <Setter Property="Background" Value="{DynamicResource VcSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
    </ControlTheme>

    <!-- A folder row of a file tree: the whole row opens and closes it. -->
    <ControlTheme x:Key="FileFolderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
      </Style>
    </ControlTheme>

    <!-- An icon button 22 by 22 on a file row of the stage panel: Stage, Unstage, Discard; also the
         close buttons of the panels and pages, the resolver's arrows and the search bar's. Disabled
         (nowhere to go, or while its command runs) in the disabled text colour, as every button
         theme here. -->
    <ControlTheme x:Key="VcIconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Screen readers and UI Automation read the tooltip's words as the button's name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding (ToolTip.Tip), RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>

    <!-- The main action of a panel or a dialog: the accent background (the commit button). -->
    <ControlTheme x:Key="VcPrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource VcAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VcAccentTextBrush}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <!-- Disabled: the control background, with a border so that it shows on a light panel too. -->
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
    </ControlTheme>

    <!-- A button that destroys work, after a question: the danger background, white text. -->
    <ControlTheme x:Key="VcDangerButton" TargetType="Button" BasedOn="{StaticResource VcPrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource VcDangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </ControlTheme>

    <!-- A check box 20 high: a box of 14 with rounded corners, the accent with a check mark when ticked. -->
    <ControlTheme x:Key="VcCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
            <Border Name="Box"
                    Width="14" Height="14"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource VcBorderBrush}"
                    Background="{DynamicResource VcControlBackgroundBrush}"
                    VerticalAlignment="Center">
              <c:Icon Name="Check" Data="{DynamicResource IconCheck}" Width="10" Height="10"
                      Foreground="{DynamicResource VcAccentTextBrush}" IsVisible="False" />
            </Border>
            <ContentPresenter Grid.Column="1"
                              Margin="8,0,0,0"
                              Content="{TemplateBinding Content}"
                              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource VcAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VcAccentBrush}" />
      </Style>
      <Style Selector="^:checked /template/ c|Icon#Check">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <!-- Thin separator between toolbar groups. -->
  <Style Selector="Border.toolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,10" />
    <Setter Property="Background" Value="{DynamicResource VcBorderBrush}" />
  </Style>

  <!-- Secondary text: hints, counts, empty-state explanations. -->
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
  </Style>

  <!-- An error message: why something the user asked for failed. -->
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource VcDangerBrush}" />
  </Style>

  <!-- Small heading text: column headers and section headers. -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A tooltip takes no input. Tooltips are drawn on the window's overlay layer (D105, App's
       static constructor) and slide back inside the window at its edge: at the bottom edge the
       tooltip of a status bar control lies over the pointer. A press there reaches the control
       under it, as a user who rested on the control until its tooltip showed expects, instead of
       closing the tooltip and doing nothing else; the control keeps its hover look meanwhile. -->
  <Style Selector="ToolTip">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

</Styles>
