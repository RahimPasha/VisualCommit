<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VisualCommit.App.Controls">

  <!-- Control themes and shared styles. Colours come from Theme/Tokens.axaml. -->

  <Styles.Resources>

    <!-- Toolbar button: icon above label. -->
    <ControlTheme x:Key="{x:Type c:ToolbarButton}" TargetType="c:ToolbarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="Padding" Value="6,5,6,4" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <!-- Screen readers and UI Automation read the label as the button's name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Spacing="3">
              <c:Icon Data="{TemplateBinding IconData}" Width="18" Height="18" HorizontalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Label}" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>

    <!-- A small button with no frame, for an icon or a short text in the tab strip and status bar. -->
    <ControlTheme x:Key="VcFlatButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>

    <!-- The body of a repo tab: its title, left-aligned, filling the tab. The tab's own Border
         draws the background, so the button only shows the pointer over it. -->
    <ControlTheme x:Key="VcTabButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="Padding" Value="14,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- A button with an icon and a label in a row, for the welcome page and forms. -->
    <ControlTheme x:Key="VcActionButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource VcPanelBackgroundBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>


    <!-- A small text button: Flat and Tree (the one in use with the selection background, class
         "selected"), and the stage panel's and diff view's actions. -->
    <ControlTheme x:Key="FileListToggle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
      <Style Selector="^.selected">
        <Setter Property="Background" Value="{DynamicResource VcSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
    </ControlTheme>

    <!-- A folder row of a file tree: the whole row opens and closes it. -->
    <ControlTheme x:Key="FileFolderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
      </Style>
    </ControlTheme>

    <!-- An icon button 22 by 22 on a file row of the stage panel: Stage, Unstage, Discard. -->
    <ControlTheme x:Key="VcIconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Screen readers and UI Automation read the tooltip's words as the button's name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding (ToolTip.Tip), RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource VcHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextPrimaryBrush}" />
      </Style>
    </ControlTheme>

    <!-- The main action of a panel or a dialog: the accent background (the commit button). -->
    <ControlTheme x:Key="VcPrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource VcAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VcAccentTextBrush}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource VcControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VcTextDisabledBrush}" />
      </Style>
    </ControlTheme>

    <!-- A button that destroys work, after a question: the danger background, white text. -->
    <ControlTheme x:Key="VcDangerButton" TargetType="Button" BasedOn="{StaticResource VcPrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource VcDangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </ControlTheme>

  </Styles.Resources>

  <!-- Thin separator between toolbar groups. -->
  <Style Selector="Border.toolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,10" />
    <Setter Property="Background" Value="{DynamicResource VcBorderBrush}" />
  </Style>

  <!-- Secondary text: hints, counts, empty-state explanations. -->
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
  </Style>

  <!-- An error message: why something the user asked for failed. -->
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource VcDangerBrush}" />
  </Style>

  <!-- Small heading text: column headers and section headers. -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource VcTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
