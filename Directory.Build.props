<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Package vulnerability notices stay warnings: a new advisory must not break the build,
         and neither must a package source that cannot be asked for advisories (NU1900: the
         request failed; NU1905: a configured audit source has no advisory data). -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Product>VisualCommit</Product>
    <Version>0.1.0</Version>
    <Authors>VisualCommit contributors</Authors>
    <Copyright>Copyright (c) VisualCommit contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RahimPasha/VisualCommit</RepositoryUrl>
  </PropertyGroup>
</Project>
